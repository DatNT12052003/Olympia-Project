# Biến môi trường production (deploy/.env). Sao chép rồi điền giá trị thật; KHÔNG commit .env.
# Tạo khóa ngẫu nhiên: openssl rand -base64 48

# --- Tên miền (DNS A record trỏ về IP VPS) ---
APP_DOMAIN=olympia.example.vn
LIVEKIT_DOMAIN=av.olympia.example.vn
TURN_DOMAIN=turn.olympia.example.vn
# Email nhận thông báo Let's Encrypt
ACME_EMAIL=admin@example.vn
# Phiên bản (gắn vào image và lỗi frontend), ví dụ: git rev-parse --short HEAD
RELEASE=prod

# --- Bí mật ---
POSTGRES_PASSWORD=
JWT_SECRET=
# Tối thiểu 32 ký tự
LIVEKIT_API_KEY=olympia
LIVEKIT_API_SECRET=
GRAFANA_ADMIN_PASSWORD=

# --- Media câu hỏi: object storage S3-compatible + CDN (DL-024, ví dụ Cloudflare R2) ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=olympia-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Origin trình duyệt tải media và upload presigned (cho Content-Security-Policy của Caddy)
MEDIA_ORIGIN=https://<account-id>.r2.cloudflarestorage.com
MEDIA_UPLOAD_ORIGIN=https://<account-id>.r2.cloudflarestorage.com

# --- Email (xác minh, quên mật khẩu) ---
SMTP_URL=smtps://user:pass@smtp.example.vn:465
MAIL_FROM=Olympia Online <no-reply@olympia.example.vn>

# --- Vận hành ---
LOG_LEVEL=info
DATABASE_POOL_SIZE=20
API_RATE_LIMIT_PER_MINUTE=600
MAX_ACTIVE_ROOMS_PER_HOST=5
MAX_SPECTATORS_PER_ROOM=200

# --- Sao lưu PostgreSQL (bucket riêng, không công khai) ---
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=olympia-backups
BACKUP_S3_PREFIX=postgres
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
# Giờ UTC: 19:00 UTC = 02:00 giờ Việt Nam
BACKUP_CRON=0 19 * * *
