{
  "name": "@olympia/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=.env src/infrastructure/database/run-migrations.ts up",
    "db:migrate:revert": "tsx --conditions=development --env-file-if-exists=.env src/infrastructure/database/run-migrations.ts down"
  },
  "dependencies": {
    "@olympia/shared": "^0.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  }
}
