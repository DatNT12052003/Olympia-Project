{
  "name": "@olympia/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=.env src/infrastructure/database/run-migrations.ts up",
    "db:migrate:revert": "tsx --conditions=development --env-file-if-exists=.env src/infrastructure/database/run-migrations.ts down",
    "user:grant-super-admin": "tsx --conditions=development --env-file-if-exists=.env src/scripts/grant-super-admin.ts",
    "e2e:server": "tsx --conditions=development src/scripts/e2e-server.ts",
    "load:test": "tsx --conditions=development src/scripts/load/load-test.ts",
    "load:recovery": "tsx --conditions=development --env-file-if-exists=.env src/scripts/load/recovery-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@node-rs/argon2": "^2.2.2",
    "@olympia/shared": "^0.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "2.19.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.5.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  }
}
