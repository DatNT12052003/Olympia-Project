NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Danh sách origin được phép, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://olympia:olympia@localhost:5440/olympia
REDIS_URL=redis://localhost:6380

# Số proxy tin cậy phía trước API (0 khi chạy trực tiếp)
TRUST_PROXY=0
# URL giao diện web, dùng tạo link trong email
APP_URL=http://localhost:5173

# Khóa ký JWT, tối thiểu 32 ký tự; mỗi môi trường một giá trị riêng.
# Tạo mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GUEST_SESSION_TTL_HOURS=24
# Cookie chỉ gửi qua HTTPS; bỏ trống = bật khi NODE_ENV=production
# COOKIE_SECURE=false

# Giới hạn đăng nhập sai liên tiếp (BR-AUTH-03)
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# Mailpit khi dev (xem thư tại http://localhost:8026)
SMTP_URL=smtp://localhost:1026
MAIL_FROM=Olympia Online <no-reply@olympia.local>

# Giới hạn phòng thi (DL-031)
MAX_ACTIVE_ROOMS_PER_HOST=5
MAX_SPECTATORS_PER_ROOM=200
RECONNECT_GRACE_SECONDS=120
ROOM_IDLE_MINUTES=60
# Host mất kết nối quá thời gian này thì trận kết thúc bất thường (đặc tả 4.5)
HOST_RECONNECT_MINUTES=10

# Object storage S3-compatible cho media câu hỏi (DL-025: SeaweedFS trong docker-compose)
S3_ENDPOINT=http://localhost:8340
# Endpoint trình duyệt dùng trong presigned URL; bỏ trống = S3_ENDPOINT
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=olympia-media
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
